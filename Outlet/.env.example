# Copy this file to .env in this same folder, then fill in your own values:
#     cp .env.example .env
# Git ignores .env, so your password and key never get committed or shared.

# The password every teammate types into Outlet's Settings. Make up your own.
OUTLET_TEAM_KEY=

# Your own Gemini API key, from Google AI Studio. Leave it empty to keep the AI buttons off.
GEMINI_API_KEY=

# Optional:
# GEMINI_MODEL=gemini-3.8-flash
# Asked once when the main model is overloaded or takes over 30 seconds. Leave empty to turn that off.
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# OUTLET_PORT=8000
