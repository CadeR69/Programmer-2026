# Copy this to .env for local testing only. In production (Render), set
# these as secret environment variables in the dashboard instead — never
# commit a real .env file.

# Secret that becomes part of the connector URL: https://.../mcp/<this value>
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_ACCESS_TOKEN=

OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides — leave blank to use the defaults in server.py
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=
XAI_MODEL=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
